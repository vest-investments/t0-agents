# Release-gate smoke verification:
#   This .env is the one referenced by `--env-file` in
#   examples/SMOKE.md.  Copy this file to examples/agent/.env
#   before running any docker-backed batch.
#   See examples/SMOKE.md for the full per-batch checklist.

# Provider API key — required by every gateway-backed example in this
# track. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Gateway image tag. Override locally to pin a different release; the
# compose default falls back to the value referenced here when unset.
T0_GATEWAY_VERSION=2026.4.0
